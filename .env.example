# Copie este arquivo para .env e preencha os valores

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# Admin
ADMIN_USER=admin
ADMIN_SENHA=admin123

# Mercado Pago
MP_ACCESS_TOKEN=seu_access_token_do_mercado_pago
MP_WEBHOOK_SECRET=seu_webhook_secret

# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados
# Exemplo Windows: C:\Users\SEU_USUARIO\AppData\Local\JulianaTransportes\juliana.db
DB_PATH=
